ius:11px}
  .nav{flex-direction:row;justify-content:center;margin:0;gap:4px}.nav button{width:auto;padding:9px 10px;font-size:.78rem}.nav button::after{display:none}
  .side-progress{display:none}.sidebar-bottom{margin:0}.sidebar-bottom .mini-btn:first-child{display:none}
  .page{padding-top:34px}
  .hero-grid,.results-hero,.results-grid,.about-grid{grid-template-columns:1fr}
}
@media(max-width:680px){
  .nav button span{display:none}
  .nav button{min-width:42px;text-align:center}
  .domain-list{grid-template-columns:1fr}
  .scale{grid-template-columns:1fr}
  .choice{min-height:58px;flex-direction:row;justify-content:flex-start;padding:10px 14px}
  .choice span{text-align:left}
  .question-card{min-height:0}
  .axis-row{grid-template-columns:92px 1fr}.axis-label{grid-column:2;text-align:left;margin-top:-7px}
  .quiz-footer{flex-direction:column}.quiz-footer .right{display:grid;grid-template-columns:1fr 1fr}.quiz-footer button{width:100%}
}

.participant-panel{margin-top:30px;padding:18px;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:end}
.field label{display:block;color:var(--muted);font-size:.78rem;margin-bottom:8px;font-weight:700}
.field select,.field input,.field textarea{
  width:100%;background:var(--panel-2);color:var(--text);border:1px solid var(--line);border-radius:13px;
  padding:12px 13px;outline:none
}
.field select:focus,.field input:focus,.field textarea:focus{border-color:var(--accent)}
.participant-current{margin-top:9px;color:var(--muted);font-size:.82rem}
.participant-current b{color:var(--text)}
.data-toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
.data-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px}
.data-list{display:grid;gap:9px;margin-top:14px}
.data-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);background:var(--panel-2);border-radius:14px}
.data-row strong{display:block}
.data-row small{display:block;color:var(--muted);margin-top:4px;line-height:1.4}
.row-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.row-actions button{border:1px solid var(--line);background:#171b18;border-radius:9px;padding:8px 10px;cursor:pointer;color:var(--muted);font-size:.78rem}
.row-actions button:hover{color:var(--text);border-color:#4a584f}
.info-banner{border:1px solid rgba(114,212,155,.28);background:var(--accent-soft);border-radius:16px;padding:15px 17px;color:#d8e8dd;line-height:1.55}
.file-drop{border:1px dashed #465149;border-radius:16px;padding:22px;text-align:center;background:#0d100e;color:var(--muted);cursor:pointer}
.file-drop:hover{border-color:var(--accent);color:var(--text)}
.dataset-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px}
.dataset-stats .stat{padding:15px}
.dataset-stats .stat b{font-size:1.35rem}
.tag{display:inline-flex;padding:4px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-size:.7rem;font-weight:800;margin-left:7px}
.danger-btn{border-color:rgba(255,142,142,.3)!important;color:var(--danger)!important}
@media(max-width:800px){.participant-panel,.data-grid{grid-template-columns:1fr}.dataset-stats{grid-template-columns:repeat(2,1fr)}.data-row{grid-template-columns:1fr}.row-actions{justify-content:flex-start}}

</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">G100</div>
      <div><strong>Goûts 100</strong><span>Cartographie personnelle</span></div>
    </div>
    <nav class="nav">
      <button class="active" data-page="home" title="Accueil">Accueil <span>01</span></button>
      <button data-page="quiz" title="Test">Test <span>02</span></button>
      <button data-page="results" title="Résultats">Résultats <span>03</span></button>
      <button data-page="data" title="Données">Données <span>04</span></button>
      <button data-page="about" title="À propos">À propos <span>05</span></button>
    </nav>
    <div class="side-progress">
      <label><span>Progression</span><b id="sideProgressText">0 / 100</b></label>
      <div class="progress-track"><div class="progress-fill" id="sideProgressFill"></div></div>
    </div>
    <div class="sidebar-bottom">
      <button class="mini-btn" id="resumeBtn">Reprendre le test</button>
      <button class="mini-btn" id="settingsBtn">Personnalisation</button>
    </div>
  </aside>

  <main>
    <section class="page active" id="home">
      <div class="shell">
        <div class="eyebrow">Test de goûts - 100 questions</div>
        <h1>Cartographier ce que vous aimez, sans vous enfermer dans une case.</h1>
        <p class="lead">Goûts 100 explore dix domaines de préférence et les relie à plusieurs tendances transversales : recherche de nouveauté, intensité, structure, sociabilité, rapport à la nature, esthétique, numérique, énergie, curiosité culturelle, richesse sensorielle et créativité.</p>

        <div class="card participant-panel">
          <div class="field">
            <label for="participantSelect">Qui répond ?</label>
            <select id="participantSelect"><option value="">Sélectionner un nom</option></select>
            <div class="participant-current" id="participantCurrent">Aucun participant sélectionné.</div>
          </div>
          <button class="secondary" id="addParticipantBtn">Ajouter un nom</button>
        </div>

        <div class="hero-actions">
          <button class="primary" id="startBtn">Commencer les 100 questions</button>
          <button class="secondary" id="continueBtn">Continuer ma session</button>
        </div>

        <div class="hero-grid">
          <div class="card card-pad">
            <div class="eyebrow">Ce qui est exploré</div>
            <div class="domain-list" id="domainList"></div>
            <p class="note">Les résultats sont descriptifs et exploratoires. Ce test n'est ni un instrument psychométrique validé, ni un outil clinique, ni une mesure de personnalité.</p>
          </div>
          <div class="card card-pad">
            <div class="stat-grid">
              <div class="stat"><b>100</b><span>questions</span></div>
              <div class="stat"><b>10</b><span>domaines</span></div>
              <div class="stat"><b>11</b><span>axes transversaux</span></div>
              <div class="stat"><b>Local</b><span>aucune donnée envoyée</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="page" id="quiz">
      <div class="shell">
        <div class="quiz-head">
          <div>
            <div class="eyebrow">Votre cartographie - <span id="quizParticipantName">participant</span></div>
            <h2>100 préférences, une vue d'ensemble.</h2>
          </div>
          <div class="quiz-count" id="quizCount">Question 1 / 100</div>
        </div>

        <div class="section-progress" id="sectionProgress"></div>

        <div class="card question-card">
          <div class="domain-badge" id="domainBadge">Alimentation</div>
          <div class="q-number" id="qNumber">Question 01</div>
          <div class="question-text" id="questionText"></div>

          <div class="scale" id="scale">
            <button class="choice" data-value="1"><strong>1</strong><span>Pas du tout</span></button>
            <button class="choice" data-value="2"><strong>2</strong><span>Peu</span></button>
            <button class="choice" data-value="3"><strong>3</strong><span>Mitigé</span></button>
            <button class="choice" data-value="4"><strong>4</strong><span>Beaucoup</span></button>
            <button class="choice" data-value="5"><strong>5</strong><span>Énormément</span></button>
          </div>
        </div>

        <div class="quiz-footer">
          <button class="ghost" id="skipBtn">Laisser sans réponse</button>
          <div class="right">
            <button class="secondary" id="prevBtn">Précédente</button>
            <button class="primary" id="nextBtn">Suivante</button>
          </div>
        </div>
        <p class="note">Raccourcis : <span class="kbd">1</span> à <span class="kbd">5</span> pour répondre, <span class="kbd">←</span> et <span class="kbd">→</span> pour naviguer.</p>
      </div>
    </section>

    <section class="page" id="results">
      <div class="shell">
        <div class="eyebrow">Résultat final</div>
        <h2>Votre carte de goûts</h2>
        <p class="lead" id="resultIntro">Répondez au test pour générer votre profil.</p>

        <div id="resultsContent" hidden>
          <div class="results-hero">
            <div class="card profile-card">
              <div class="eyebrow">Profil synthétique</div>
              <div class="profile-title" id="profileTitle"></div>
              <div class="profile-copy" id="profileCopy"></div>
              <div class="actions-row">
                <button class="primary" id="copyBtn">Copier mon résumé</button>
                <button class="secondary" id="downloadBtn">Exporter mes résultats JSON</button>
                <button class="ghost" id="restartBtn">Recommencer</button>
              </div>
            </div>
            <div class="card score-ring">
              <canvas id="radar" width="460" height="460" aria-label="Radar des dimensions principales"></canvas>
            </div>
          </div>

          <div class="results-grid">
            <div class="card result-card">
              <h3>Axes transversaux</h3>
              <p class="note" style="margin-top:0">Chaque axe est bipolaire. La barre indique vers quel pôle vos réponses tendent.</p>
              <div id="axisResults"></div>
            </div>
            <div class="card result-card">
              <h3>Affinité par domaine</h3>
              <p class="note" style="margin-top:0">Il s'agit de la moyenne de vos réponses dans chaque domaine, et non d'un classement absolu de vos goûts.</p>
              <div id="domainResults"></div>
            </div>
          </div>

          <div class="results-grid">
            <div class="card result-card">
              <h3>Vos préférences les plus marquées</h3>
              <div class="top-list" id="topLikes"></div>
            </div>
            <div class="card result-card">
              <h3>Ce qui vous attire le moins</h3>
              <div class="top-list" id="topDislikes"></div>
            </div>
          </div>
        </div>

        <div class="card card-pad" id="emptyResults">
          <h3>Pas encore assez de réponses.</h3>
      